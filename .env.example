# demo: no network or credentials; live: BUFF + Steam requests
SCAN_MODE=demo
BUFF_COOKIE=
BUFF_MIN_PRICE=20
BUFF_MAX_PRICE=2000
BUFF_PAGE_SIZE=20
STEAM_REQUEST_INTERVAL=1.5
# BUFF requests wait at least 5 seconds; 429 responses use bounded backoff.
BUFF_REQUEST_INTERVAL=5.0
CACHE_TTL_SECONDS=900
DATABASE_PATH=data/scanner.db
APP_PORT=5050
USD_CNY_FALLBACK_RATE=7.00
